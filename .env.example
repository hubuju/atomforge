# Copy this file to `.env` and fill in your key (never commit `.env`).
# APP_AI_KEY is required — the whole generation pipeline runs on it.

# DeepSeek API key (https://platform.deepseek.com -> API Keys)
APP_AI_KEY=sk-your-key-here

# OpenAI-compatible endpoint (DeepSeek by default; GLM / Qwen / vLLM / ... also work)
APP_AI_BASE_URL=https://api.deepseek.com/v1

# SQLite single-file persistence (no changes needed)
DATABASE_URL=sqlite:////data/atomforge.db
