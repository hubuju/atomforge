{
    "title": "chat_messages",
    "type": "object",
    "description": "Conversation history between the user and the generation agent inside a project",
    "properties": {
        "id": {
            "type": "integer",
            "description": "Autoincrement primary key"
        },
        "user_id": {
            "type": "string",
            "description": "Owner user id"
        },
        "project_id": {
            "type": "integer",
            "description": "Related project id"
        },
        "role": {
            "type": "string",
            "description": "Message role: user or assistant"
        },
        "content": {
            "type": "string",
            "description": "Message text content"
        },
        "kind": {
            "type": "string",
            "description": "Message kind: text, plan, generation, fix"
        }
    },
    "required": [
        "project_id",
        "role",
        "content",
        "user_id"
    ]
}